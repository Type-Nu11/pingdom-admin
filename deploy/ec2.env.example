# Public build config only. Copy to .env.ec2.local (gitignored).
PINGDOM_IMAGE_TAG=replace-with-release-commit
VITE_NAVER_MAP_CLIENT_ID=replace-with-public-maps-client-id
VITE_APP_BASE_PATH=/operator/
PINGDOM_WEB_BIND_ADDRESS=127.0.0.1
PINGDOM_WEB_PORT=8082
# Existing authenticated WEB gateway, NOT the API backend or this web container.
PINGDOM_API_UPSTREAM=host.docker.internal:8081
